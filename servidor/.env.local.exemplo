# Teste no PC (docker-compose.local.yml). Copie para .env.local e preencha.
# Banco, Redis, cookie e endereço de retorno já vêm do docker-compose.local.yml.

SECRET_KEY=troque-por-um-texto-longo-e-aleatorio-so-para-teste

# Login Microsoft (Entra): registro do app com a URI de retorno http://localhost:3000/getAToken
AUTHORITY=https://login.microsoftonline.com/<ID-DO-LOCATARIO>
CLIENT_ID=<ID-DO-APLICATIVO>
CLIENT_SECRET=<SEGREDO-DO-APLICATIVO>
DOMINIO_PERMITIDO=grupoimpper.com.br
ADMIN_EMAILS=<seu.email@grupoimpper.com.br>
PERFIL_NOVO_PERMISSOES=

# TOTVS RM (usuário de serviço só de leitura). O PC precisa enxergar o endereço do RM.
TOTVS_BASE_URL=https://<servidor-do-rm>:8051
rm_user=
# senha em Base64 (padrão da Plataforma) — ou use TOTVS_SENHA em texto
rm_senha=
TOTVS_VERIFICAR_SSL=1

# Assistente com IA: deixe vazio
IA_PROVEDOR=

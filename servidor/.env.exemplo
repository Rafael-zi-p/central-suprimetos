# ════════════════════════════════════════════════════════════════
#  Central de Suprimentos — variáveis de ambiente
#  Copie para ".env" (ou cadastre no Coolify). Nunca coloque no Git.
# ════════════════════════════════════════════════════════════════

# ── Flask ──
SECRET_KEY=troque-por-um-texto-longo-e-aleatorio
PORT=3000
SESSAO_MINUTOS=480
COOKIE_SEGURO=1

# ── Sessão (Redis — o mesmo da Plataforma, com prefixo próprio) ──
SESSION_REDIS_URL=redis://usuario:senha@redis:6379/2
SESSION_KEY_PREFIX=suprimentos:

# ── Banco (PostgreSQL) ──
# Use DATABASE_URL (como o Coolify entrega) OU os campos separados.
DATABASE_URL=postgresql://usuario:senha@postgres:5432/automacoes
DB_NAME=automacoes
DB_SCHEMA=suprimentos
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=suprimentos_app
# DB_PASSWORD=...

# ── Login Microsoft (Entra) — registro de app próprio ou o da Plataforma ──
AUTHORITY=https://login.microsoftonline.com/<ID-DO-LOCATARIO>
CLIENT_ID=<ID-DO-APLICATIVO>
CLIENT_SECRET=<SEGREDO-DO-APLICATIVO>
REDIRECT_URI=https://suprimentos.grupoimpper.com.br/getAToken
DOMINIO_PERMITIDO=grupoimpper.com.br
# IDs de grupos do Entra que podem entrar (separados por vírgula). Vazio = todo o domínio.
GRUPOS_ACESSO=
# Administradores iniciais (até cadastrarem os perfis no app)
ADMIN_EMAILS=rafael.souza@grupoimpper.com.br
# Perfil criado no primeiro acesso
PERFIL_NOVO_ATIVO=1
# Abas liberadas para quem entra pela primeira vez (ex.: sc,mesa,oc). Vazio = nenhuma, até o administrador liberar
PERFIL_NOVO_PERMISSOES=

# ── TOTVS RM (usuário de serviço, só leitura nas consultas CUBO.*) ──
TOTVS_BASE_URL=https://imperialempreendimentos166031.rm.cloudtotvs.com.br:8051
rm_user=
# senha em Base64 (padrão da Plataforma) — ou use TOTVS_SENHA em texto
rm_senha=
TOTVS_CONSULTAS_PERMITIDAS=CUBO.*
TOTVS_VERIFICAR_SSL=1
TOTVS_TIMEOUT=600
# Fuso da agenda da atualização automática
FUSO_HORARIO=America/Sao_Paulo
# Consultas do RM sem obra (passam sem filtro por obra para quem tem obras restritas)
TOTVS_CONSULTAS_GLOBAIS=CUBO.SUP.FORN*,CUBO.SUP.INS*

# ── Chat da equipe ──
CHAT_RETENCAO_MIN=240

# ── IA do assistente (deixe IA_PROVEDOR vazio até haver contrato e política de uso de IA) ──
IA_PROVEDOR=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELO=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODELO=gpt-4o-mini
IA_LIMITE_MIN=10

# ── Servidor web ──
WEB_WORKERS=3
WEB_THREADS=4
WEB_TIMEOUT=660
